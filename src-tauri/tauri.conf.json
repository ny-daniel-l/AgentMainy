{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentMainy",
  "version": "0.2.0",
  "identifier": "online.thenightwatcher.agentpet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "AgentMainy",
        "url": "index.html",
        "width": 260,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "x": 1200,
        "y": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://pets.thenightwatcher.online data: ; connect-src 'self' https://pets.thenightwatcher.online https://agentpet.thenightwatcher.online https://api.kanye.rest ipc: http://ipc.localhost ws: wss: ; frame-src http://127.0.0.1:* ; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "license": "MIT",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "ny-daniel-l",
    "homepage": "https://github.com/ny-daniel-l/AgentMainy",
    "shortDescription": "Desktop pet + AI agent team + smart home, in one dashboard.",
    "longDescription": "AgentMainy floats a pet on your desktop that reacts live to your AI coding agents, runs a whole team of Claude Code agents with shared memory (UltraClaude engine), and shows your Home Assistant home at a glance.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese",
          "Vietnamese"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "resources": {
      "../engine/ultraclaude": "engine/ultraclaude"
    }
  }
}
